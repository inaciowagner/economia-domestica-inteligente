# Copie para .env e ajuste os valores:  cp .env.example .env

# Chave secreta do Flask (sessões e CSRF). Gere uma nova com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria

# Conexão com o PostgreSQL: postgresql+psycopg2://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=postgresql+psycopg2://economia:economia@localhost:5432/economia_domestica

# 1 = modo debug (somente em desenvolvimento)
FLASK_DEBUG=1

# Fuso horário usado para calcular "hoje" (padrão: America/Sao_Paulo)
TIMEZONE=America/Sao_Paulo
